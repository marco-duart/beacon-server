{
  "info": {
    "_postman_id": "d1f7b27a-693a-48df-b9de-a1ccaea09df9",
    "name": "Beacon API",
    "description": "Self-hosted error tracking API. Run \"Auth > Login\" then \"Systems > Create System\" first (Collection Runner works top-to-bottom) to populate {{accessToken}} and {{systemApiKey}}, then fire any request in \"Ingestion\". See beacon-server/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@beacon.dev",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "super-secret-123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "systemId",
      "value": "",
      "type": "string"
    },
    {
      "key": "systemApiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "issueId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Run this first. Create the admin beforehand with `npm run seed:admin -- --email {{adminEmail}} --password {{adminPassword}}`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const loginData = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', loginData.accessToken);",
                  "pm.test('accessToken captured', () => pm.expect(loginData.accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (GET /auth/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Systems",
      "item": [
        {
          "name": "Create System",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/systems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "systems"
              ]
            },
            "description": "Run after Login. Captures {{systemApiKey}} and {{systemId}} for the Ingestion folder.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Checkout API\",\n  \"retentionPolicy\": \"30d\",\n  \"notifyEmails\": \"oncall@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const systemData = pm.response.json();",
                  "pm.collectionVariables.set('systemApiKey', systemData.apiKey);",
                  "pm.collectionVariables.set('systemId', systemData.id);",
                  "pm.test('apiKey captured', () => pm.expect(systemData.apiKey).to.match(/^bcn_live_/));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Systems",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/systems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "systems"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Ingestion (error payloads)",
