# Server
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (dashboard URL in prod)
CORS_ORIGIN=http://localhost:5173

# SQLite database file (created automatically on boot)
DATABASE_PATH=./data/beacon.sqlite

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Ingestion queue worker
QUEUE_POLL_INTERVAL_MS=200
QUEUE_BATCH_SIZE=25

# Retention sweep
RETENTION_CRON=0 * * * *

# Email notifications (leave EMAIL_PROVIDER unset to disable notifications)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=beacon@example.com
